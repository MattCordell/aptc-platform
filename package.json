{
  "name": "aptc-platform",
  "private": true,
  "version": "0.0.0",
  "description": "APTC Catalogue Maintenance Platform - workspace root (not published)",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter aptc-frontend dev",
